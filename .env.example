# .env.example - Kopieren Sie diese Datei zu .env und passen Sie die Werte an
#
# KONFIGURIERBARE PARAMETER (siehe CONFIGURATION.md):
# ✓ Eingangslager.Vorrat (INITIAL_RAW_STOCK)
# ✓ Eingangslager.Intervall (INPUT_WAREHOUSE_INTERVAL)
# ✓ Eingangslager.Kapazität (INPUT_WAREHOUSE_CAPACITY)
# ✓ Pufferlager.Kapazität (BUFFER1/2/3_CAPACITY)
# ✓ Maschinen.Zykluszeit (MACHINE_*_CYCLE_TIME)
# ✓ Qualitätsprüfung.RejectRate (SCRAP_CHANCE)
# ✓ Recyclinglager (RECYCLING_WAREHOUSE_CAPACITY = unbegrenzt)
# ✓ Fertigwarenlager (FINISHED_GOODS_CAPACITY = unbegrenzt)

# ============ OPC-UA ============
OPCUA_SERVER_URL=opc.tcp://localhost:50000
OPCUA_UPDATE_INTERVAL=0.5

# ============ SIMULATION ============
SIMULATION_SPEED=0.1  # Verzögerung pro Zyklus in Sekunden (höher = langsamer)
SIMULATION_CYCLES_PER_LLM=300  # LLM-Analyse alle N Zyklen

# ============ MASCHINEN ============
# Fraese
MACHINE_FRAESE_CYCLE_TIME=2.0
MACHINE_FRAESE_ERROR_RATE=0.02

# Drehbank
MACHINE_DREHBANK_CYCLE_TIME=1.5
MACHINE_DREHBANK_ERROR_RATE=0.01

# Bohrmaschine
MACHINE_BOHR_CYCLE_TIME=1.0
MACHINE_BOHR_ERROR_RATE=0.03

# Schleifmaschine
MACHINE_SCHLEIF_CYCLE_TIME=2.5
MACHINE_SCHLEIF_ERROR_RATE=0.02

# ============ QUALITÄTSPRÜFUNG ============
SCRAP_CHANCE=0.01  # Ausschussrate: Wahrscheinlichkeit für Ausschuss pro Zyklus (0.01 = 1%)

# ============ PUFFER ============
# Kapazität für jeden Puffer (Stück) - Diese Parameter können verändert werden
BUFFER1_CAPACITY=100
BUFFER2_CAPACITY=100
BUFFER3_CAPACITY=100

# ============ WARENEINGANGSLAGER ============
# Diese Parameter können verändert werden
INPUT_WAREHOUSE_CAPACITY=100000   # Kapazität des Wareneingangslagers (Stück; wird nicht nachgefüllt)
INITIAL_RAW_STOCK=10000           # Anfangsbestand im Wareneingangslager (Stück)
INPUT_WAREHOUSE_INTERVAL=1.0      # Zeitintervall für Material-Transport zum 1. Puffer (Sekunden)

# ============ LAGER (unbegrenzte Kapazität) ============
RECYCLING_WAREHOUSE_CAPACITY=99999      # Recyclinglager: UNBEGRENZTE Kapazität für Ausschuss
FINISHED_GOODS_CAPACITY=99999           # Fertigwarenlager: UNBEGRENZTE Kapazität für fertige Produkte

# ============ QUALITÄT ============
QUALITY_DEGRADATION_RATE=0.01  # Qualitätsverlust pro Zyklus
QUALITY_REPAIR_BONUS=5  # Qualitätsverbesserung bei Reparatur
MAX_QUALITY=100
MIN_QUALITY=80

# ============ FEHLER ============
ERROR_REPAIR_CHANCE=0.3  # 30% Chance auf Reparatur pro Zyklus
ERROR_RATE_MIN=0.001
ERROR_RATE_MAX=0.5

# ============ LLM (Default: OpenAI) ============
OPENAI_API_KEY=your-api-key-here  # Für LLM-Optimierung (Standard-Provider)
LLM_MODEL=gpt-4-turbo-preview     # NUR für OpenAI; MCI nutzt MCI_MODEL (siehe unten)
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
LLM_MIN_ANALYSIS_INTERVAL=60  # Sekunden zwischen LLM-Aufrufen

# ============ MCI LLM (nur bei Start mit "--llm mci") ============
# Eigene REST-API des MCI-Accounts (Header X-Client-ID / X-Client-Secret).
MCI_BASE_URL=https://ca-backend-mciai-prod.mangoforest-0c569892.swedencentral.azurecontainerapps.io
MCI_API_KEY=your-mci-client-id
MCI_API_SECRET=your-mci-client-secret
# Alternativ akzeptiert werden auch die Namen aus dem MCI-Beispiel:
# CLIENT_ID=your-mci-client-id
# CLIENT_SECRET=your-mci-client-secret
# MCI-Modell (eigene Variable, NICHT LLM_MODEL, damit gpt-4-turbo-preview nicht
# an MCI geschickt wird -> sonst HTTP 400). Erlaubt: gpt-4o, gpt-5.2, gpt-5-nano,
# o3, Mistral-Large-3
MCI_MODEL=gpt-4o

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_FILE=production.log